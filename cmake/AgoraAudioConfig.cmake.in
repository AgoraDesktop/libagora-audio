@PACKAGE_INIT@

# Consume Core Audio (libagora-audio), Agora's CoreAudio and — later — AudioToolbox and AudioUnit.
#
# ITS ONE PUBLIC DEPENDENCY IS CORE FOUNDATION: the status type (`OSStatus`) and the scalar types
# (`UInt32`, `SInt32`, `Boolean`) the audio headers are written in are Core Foundation's here, so a
# consumer that includes `<CoreAudio/CoreAudioTypes.h>` has to have them. The audio backends (PipeWire,
# ALSA, sndio) are PRIVATE: no type from any of them appears in a public header.

include(CMakeFindDependencyMacro)

find_dependency(CoreFoundation CONFIG)

if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
  message(FATAL_ERROR
    "libagora-audio' interface brings Core Foundation's headers, which need -fblocks. This tree builds "
    "with clang; configure with -DCMAKE_C_COMPILER=/usr/bin/clang-19.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AgoraAudioTargets.cmake")

check_required_components(AgoraAudio)
